@page "/"
@using ApexCharts
@using FinancialData.Shared.Models
@inject IJSRuntime JS

<div class="sidebar">
    <BlazorBootstrap.Button Color="ButtonColor.Primary" @onclick="AddChart">Dodaj wykres</BlazorBootstrap.Button>
	<Selection @ref="selection" HomeRef="this" />
</div>
<div class="main-content">
<div class="chart-grid">
    @foreach (var chart in Charts)
    {
        var divClass = chart.IsExpanded ? "full-width" : "half-width";

        <div class="chart-wrapper @divClass" @key="chart">
            <button class="button close" @onclick="() => RemoveChart(chart)">×</button>
            @if (chart.IsExpanded)
            {
                <button class="button expand active" @onclick="() => Collapse(chart)">↔</button>
            }
            else
            {
                <button class="button expand" @onclick="() => Expand(chart)">↔</button>
            }
            <ChartComponent OnRefReady="async r => await HandleRefReady(chart, r)" SelectionRef="selection" />
        </div>
    }
</div>
</div>
@code {
    public Selection? selection;
    private List<ChartEntry> Charts = new();

    private void AddChart()
    {
        Charts.Add(new ChartEntry());
    }

    private void RemoveChart(ChartEntry chart)
    {
        Charts.Remove(chart);
    }

    private void Expand(ChartEntry chart)
    {
        chart.IsExpanded = true;
    }

    private void Collapse(ChartEntry chart)
    {
        chart.IsExpanded = false;
    }

    private async Task HandleRefReady(ChartEntry chart, ApexChart<Record> refReady)
    {
        chart.ChartRef = refReady;
        await Task.Yield(); 
        StateHasChanged(); 
    }

    public class ChartEntry
    {
        public ApexChart<Record>? ChartRef { get; set; }
        public bool IsExpanded { get; set; } = false;
    }

    public void Update()
    {
        StateHasChanged();
    }
}
