@page "/"
@using FinancialData.Shared.Models
@using FinancialData.WebClient.Services
@inject RecordService RecordService
@inject DataParamsService DataParamsService

<PageTitle>Home</PageTitle>

@if (DataParams.Count == 0)
{
	<p><em>Loading...</em></p>
}
else
{
	@foreach (var d in DataParams)
	{
		<Dropdown Color="DropdownColor.Secondary">
			<DropdownToggleButton>@d.Value[ParamsIds[d.Key]]</DropdownToggleButton>
			<DropdownMenu>
				@foreach (var i in d.Value)
				{
					<DropdownItem Type="DropdownItemType.Button" @onclick="(() => UpdateSelection(d.Key, i.Key))">@i.Value</DropdownItem>
				}
			</DropdownMenu>
		</Dropdown>
	}

	<Button Color="ButtonColor.Secondary" @onclick="(() => GetRecords())">Pokaż</Button>
}

@if (Records != null)
{
	<h3>Records</h3>
	<table class="table">
		<thead>
			<tr>
				<th>Date</th>
				<th>Value</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var record in Records)
			{
				<tr>
					<td>@record.Date</td>
					<td>@record.Value</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<p><em>Loading...</em></p>
}

@code {
	private string StartDate = "1990-01";
	private string EndDate = "2020-10";


	private List<Record>? Records;
	private Dictionary<string, Dictionary<int, string>> DataParams = [];
	private Dictionary<string, int> ParamsIds = new()
	{
		{ "DataTypes", 0 },
		{ "Frequencies", 0 },
		{ "PresentationTypes", 0 }
	};
	private Dictionary<string, string> DefaultValues = new()
	{
		{ "DataTypes", "Wybierz dane" },
		{ "Frequencies", "Wybierz częstotliwość" },
		{ "PresentationTypes", "Wybierz sposób prezentacji" }
	};

	protected override async Task OnInitializedAsync()
	{
		await LoadDataParamsAsync();
	}

	private async Task LoadDataParamsAsync()
	{
		DataParams.Clear();
		await LoadDictionaryAsync<DataType>("DataTypes");
		await LoadDictionaryAsync<Frequency>("Frequencies");
		await LoadDictionaryAsync<PresentationType>("PresentationTypes");
	}

	private async Task LoadDictionaryAsync<T>(string key, int DTID=0, int FID=0, int PTID=0) where T : class, IParam
	{
		var data = await DataParamsService.GetDictAsync<T>(DTID, FID, PTID);
		data.TryAdd(0, DefaultValues[key]);
		DataParams[key] = data;
		if (!data.ContainsKey(ParamsIds[key]))
			ParamsIds[key] = 0;
	}

	private async Task UpdateSelection(string key, int id)
	{
		ParamsIds[key] = id;

		if (key == "DataTypes")
		{
			ParamsIds["Frequencies"] = 0;
			ParamsIds["PresentationTypes"] = 0;
		}

		if (key == "DataTypes" || key == "Frequencies")
			await LoadDictionaryAsync<PresentationType>("PresentationTypes", DTID: ParamsIds["DataTypes"], FID: ParamsIds["Frequencies"]);
		

		if (key == "DataTypes" || key == "PresentationTypes")
			await LoadDictionaryAsync<Frequency>("Frequencies", DTID: ParamsIds["DataTypes"], PTID: ParamsIds["PresentationTypes"]);
		
	}

	private async Task GetRecords()
	{
		Records = await RecordService.GetRecordsAsync(ParamsIds["DataTypes"], ParamsIds["Frequencies"], ParamsIds["PresentationTypes"], StartDate, EndDate);
	}
}