@page "/"
@using System.Xml.Serialization
@using FinancialData.Shared.DTOs
@using FinancialData.Shared.Models
@using FinancialData.WebClient.Services
@using ApexCharts
@inject RecordService RecordService
@inject DataParamsService DataParamsService

<PageTitle>Home</PageTitle>

<BlazorBootstrap.Button Color="ButtonColor.Primary" @onclick="AddChart">Dodaj wykres</BlazorBootstrap.Button>
<div class="chart-grid">
	
	@foreach (var chart in Charts)
	{
		@if (Charts.Count % 2 != 1 || Charts.Last() != chart)
		{
			<div class="chart-wrapper">
						<ChartComponent OnRefReady="r => chart.chartRef = r" />
						<BlazorBootstrap.Button Color="ButtonColor.Danger" @onclick="() => RemoveChart(chart)">Usuń</BlazorBootstrap.Button>
			</div>
		}
	}
</div>
@if (Charts.Count % 2 == 1)
{
	<div class="chart-wrapper">
		<ChartComponent OnRefReady="r => Charts.Last().chartRef = r" />
		<BlazorBootstrap.Button Color="ButtonColor.Danger" @onclick="() => RemoveChart(Charts.Last())">Usuń</BlazorBootstrap.Button>
	</div>
}


@code {

	private List<ChartEntry> Charts = new();

	private void AddChart()
	{
		var newChart = new ChartEntry();
		Charts.Add(newChart);
	}

	public void RemoveChart(ChartEntry chart)
	{
		Charts.Remove(chart);
	}

	public class ChartEntry
	{
		public List<LineSeries> Series { get; set; } = [];
		public ApexChart<Record> chartRef;
	}
}

