@page "/"
@using FinancialData.Shared.Models
@using FinancialData.WebClient.Services
@inject RecordService RecordService
@inject DataParamsService DataParamsService

<PageTitle>Home</PageTitle>

@if (DataParams.Count == 0)
{
	<p><em>Loading...</em></p>
}
else
{
	@foreach (var d in DataParams)
	{
		<Dropdown Color="DropdownColor.Secondary">
			<DropdownToggleButton>@d.Value[ParamsIds[d.Key]]</DropdownToggleButton>
			<DropdownMenu>
				@foreach (var i in d.Value)
				{
					<DropdownItem Type="DropdownItemType.Button" @onclick="(() => UpdateSelection(d.Key, i.Key))">@i.Value</DropdownItem>
				}
			</DropdownMenu>
		</Dropdown>
	}

	<Button Color="ButtonColor.Secondary" @onclick="(() => GetRecords())">Pokaż</Button>
}

@if (Records != null)
{
	<h3>Records</h3>
	<table class="table">
		<thead>
			<tr>
				<th>Date</th>
				<th>Value</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var record in Records)
			{
				<tr>
					<td>@record.Date</td>
					<td>@record.Value</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<p><em>Loading...</em></p>
}

@code {
	private int DataTypeId {
		get => ParamsIds["DataTypes"];
		set => ParamsIds["DataTypes"] = value;
	}
	private int FrequencyId {
		get => ParamsIds["Frequencies"];
		set => ParamsIds["Frequencies"] = value;
	}
	private int PresentationTypeId {
		get => ParamsIds["PresentationTypes"];
		set => ParamsIds["PresentationTypes"] = value;
	}
	private string StartDate = "1990-01";
	private string EndDate = "2020-10";


	private List<Record>? Records;
	private Dictionary<string, Dictionary<int, string>> DataParams = [];
	private Dictionary<string, int> ParamsIds = new()
	{
		{ "DataTypes", 0 },
		{ "Frequencies", 0 },
		{ "PresentationTypes", 0 }
	};

	protected override async Task OnInitializedAsync()
	{
		await LoadDataParamsAsync();
	}

	private async Task LoadDataParamsAsync()
	{
		DataParams.Clear();
		await LoadDictionaryAsync<DataType>("DataTypes", "Wybierz dane");
		await LoadDictionaryAsync<Frequency>("Frequencies", "Wybierz częstotliwość");
		await LoadDictionaryAsync<PresentationType>("PresentationTypes", "Wybierz sposób prezentacji");
	}

	private async Task LoadDictionaryAsync<T>(string key, string defauyltValue, int DataTypeId=0, int FrequencyId=0, int PresentationTypeId=0) where T : class, IParam
	{
		var data = await DataParamsService.GetDictAsync<T>(DataTypeId, FrequencyId, PresentationTypeId);
		UpdateDictionary(key, data, defauyltValue);
		if (!data.ContainsKey(ParamsIds[key]))
			ParamsIds[key] = 0;
	}

	private void UpdateDictionary(string key, Dictionary<int, string> newData, string defaultValue)
	{
		newData.TryAdd(0, defaultValue);
		DataParams[key] = newData;
	}

	private async Task UpdateSelection(string key, int id)
	{
		ParamsIds[key] = id;
		await (key switch
		{
			"DataTypes" => setDataTypeId(id),
			"Frequencies" => LoadDictionaryAsync<PresentationType>("PresentationTypes", "Wybierz sposób prezentacji", DataTypeId, id),
			"PresentationTypes" => LoadDictionaryAsync<Frequency>("Frequencies", "Wybierz częstotliwość", DataTypeId, 0, id),
			_ => throw new ArgumentException("Invalid key")
		});
	}

	private async Task setDataTypeId(int id)
	{
		FrequencyId = 0;
		PresentationTypeId = 0;

		await LoadDictionaryAsync<Frequency>("Frequencies", "Wybierz częstotliwość", id);
		await LoadDictionaryAsync<PresentationType>("PresentationTypes", "Wybierz sposób prezentacji", id);
	}

	private async Task GetRecords()
	{
		Records = await RecordService.GetRecordsAsync(DataTypeId, FrequencyId, PresentationTypeId, StartDate, EndDate);
	}
}