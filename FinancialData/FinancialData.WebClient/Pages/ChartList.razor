@using FinancialData.Shared.DTOs

<Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => AddResult(ViewerSelectorRef.GetParams())" Disabled="!Ready">Dodaj</Button>
@foreach(var result in ResultList)
{
	<div style="display:flex">
		<p>
			@($"{result.Caption}")
		</p>
		<button class="button close" style="top: 0.2rem" @onclick="() => DeleteResult(result)">×</button>
	</div>
}

@code {
	private List<SelectionResult> ResultList = [];
	[Parameter] public required ViewerSelector ViewerSelectorRef { get; set; }
	[Parameter] public EventCallback<List<SelectionResult>> OnResultChanged { get; set; }
	private bool Ready => ViewerSelectorRef.Ready && ResultList.All(x => x.Caption != ViewerSelectorRef.GetParams().Caption);

	public void AddResult(SelectionResult result)
	{
		ResultList.Add(result);
		OnResultChanged.InvokeAsync(ResultList);
	}

	private void DeleteResult(SelectionResult result)
	{
		ResultList.Remove(result);
		OnResultChanged.InvokeAsync(ResultList);
	}
}
