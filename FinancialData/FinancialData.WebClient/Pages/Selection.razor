@using System.Text
@using FinancialData.Shared.DTOs
@using FinancialData.Shared.Models
@using FinancialData.WebClient.Services
@using DataType = FinancialData.Shared.Models.DataType
@inject RecordService RecordService
@inject DataParamsService DataParamsService
<div>
	@foreach (var d in DataParams)
	{
		<BlazorBootstrap.Dropdown Color="DropdownColor.Primary" Size ="DropdownSize.Small">
			<DropdownToggleButton>@HideOverflow(d.Value[ParamsIds[d.Key]])</DropdownToggleButton>
			<BlazorBootstrap.DropdownMenu>
				@foreach (var i in d.Value)
				{
					<BlazorBootstrap.DropdownItem Type="DropdownItemType.Button" @onclick="(() => UpdateSelection(d.Key, i.Key))" Active="d.Value[ParamsIds[d.Key]]==i.Value">@i.Value</BlazorBootstrap.DropdownItem>
				}
			</BlazorBootstrap.DropdownMenu>
		</BlazorBootstrap.Dropdown>
	}
</div>

@code {
	[Parameter] public required Home HomeRef { get; set; }
	private SelectionResult SelectionResult = new();
	public SelectionResult GetParams()
	{
		var sb = new StringBuilder();
		foreach (var d in DataParams)
		{
			sb.Append(d.Value[ParamsIds[d.Key]] + " ");
		}
		SelectionResult = new SelectionResult
			{
				DataTypeId = ParamsIds["DataTypes"],
				FrequencyId = ParamsIds["Frequencies"],
				PresentationTypeId = ParamsIds["PresentationTypes"],
				Caption = sb.ToString()
			};
		return SelectionResult;
	}

	public bool Ready => ParamsIds.Values.All(x => x != 0);

	private Dictionary<string, Dictionary<int, string>> DataParams = new()
	{
		{ "DataTypes", new Dictionary<int, string> { { 0, "Loading..." } } },
		{ "Frequencies", new Dictionary<int, string> { { 0, "Loading..." } } },
		{ "PresentationTypes", new Dictionary<int, string> { { 0, "Loading..." } } }
	};

	private Dictionary<string, int> ParamsIds = new()
	{
		{ "DataTypes", 0 },
		{ "Frequencies", 0 },
		{ "PresentationTypes", 0 }
	};

	private Dictionary<string, string> DefaultValues = new()
	{
		{ "DataTypes", "Wybierz dane" },
		{ "Frequencies", "Wybierz częstotliwość" },
		{ "PresentationTypes", "Wybierz sposób prezentacji" }
	};

	protected override async Task OnInitializedAsync()
	{
		await LoadDataParamsAsync();
	}

	private async Task LoadDataParamsAsync()
	{
		//DataParams.Clear();
		await LoadDictionaryAsync<DataType>("DataTypes");
		await LoadDictionaryAsync<Frequency>("Frequencies");
		await LoadDictionaryAsync<PresentationType>("PresentationTypes");
	}

	private async Task LoadDictionaryAsync<T>(string key, int DTID = 0, int FID = 0, int PTID = 0) where T : class, IParam
	{
		var data = await DataParamsService.GetDictAsync<T>(DTID, FID, PTID);
		data.TryAdd(0, DefaultValues[key]);
		DataParams[key] = data;
		if (!data.ContainsKey(ParamsIds[key]))
			ParamsIds[key] = 0;
	}

	private async Task UpdateSelection(string key, int id)
	{
		ParamsIds[key] = id;

		if (key == "DataTypes")
		{
			ParamsIds["Frequencies"] = 0;
			ParamsIds["PresentationTypes"] = 0;
		}

		if (key is "DataTypes" or "Frequencies")
			await LoadDictionaryAsync<PresentationType>("PresentationTypes", DTID: ParamsIds["DataTypes"], FID: ParamsIds["Frequencies"]);


		if (key is "DataTypes" or "PresentationTypes")
			await LoadDictionaryAsync<Frequency>("Frequencies", DTID: ParamsIds["DataTypes"], PTID: ParamsIds["PresentationTypes"]);

		HomeRef.Update();
	}

	private string HideOverflow(string s)
	{
		int maxLength = 29;
		if (s.Length > maxLength)
			s = s.Substring(0, maxLength-3) + "...";
		return s;
	}
}
