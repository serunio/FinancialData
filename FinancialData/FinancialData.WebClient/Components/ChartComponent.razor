@using FinancialData.Shared.DTOs
@using FinancialData.Shared.Models
@using FinancialData.WebClient.Services
@using Tooltip = ApexCharts.Tooltip
@using ChartType = ApexCharts.ChartType
@inject RecordService RecordService
@inject IJSRuntime Js
@inject ILogger<ChartComponent> Logger


<div>
	<ChartList SelectorRef="SelectorRef" OnResultChanged="Refresh"/>
	@if (SeriesList.Count == 2)
	{
		<CheckboxInput Label="Scatter" ValueChanged="x => SetupScatter(x)" ValueExpression="() => _scatter"/>
	}
	@if (SeriesList.Any())
	{
		if (_scatter)
		{
			<CheckboxInput Label="Size" ValueChanged="x => SwitchSize(x)" ValueExpression="() => _size"/>

			<ApexChart @ref="_scatterRef" TItem="ScatterPoint" Options="_scatterOptions" XAxisType="XAxisType.Numeric">
				<ApexBubbleSeriesDirect TItem="ScatterPoint" 
				Items="@ScatterSeries.Points"
				Name=@($"{ScatterSeries.NameX}, {ScatterSeries.NameY}")
				XValue="p => p.X"
				YValue="p => p.Y"
				ZValue="p => p.Date"
				Extra="p => p.DateString"
				EnableSize="_size"
				OrderBy="x => x.Z"/>
			</ApexChart>
		}
		else
		{
			<ApexChart @ref="_lineChartRef" TItem="Record" XAxisType="XAxisType.Datetime" Options="_lineOptions">
				@foreach (var data in SeriesList)
				{
					<ApexPointSeries TItem="Record"
					Items="@data.Points"
					Name="@data.Name"
					SeriesType="SeriesType.Line"
					XValue="r => r.Date"
					YValue="r => r.Value"
					Extra="r => r.DateString"
					/>
				}
			</ApexChart>
		}
	}
</div>

@code {
	private ApexChart<Record>? _lineChartRef;
	private ApexChart<ScatterPoint>? _scatterRef;

	public List<LineSeries> SeriesList = [];
	public ScatterSeries ScatterSeries = new();
	[Parameter] public EventCallback<ApexChart<Record>> OnRefReady { get; set; }
	[Parameter] public required Selector SelectorRef { get; set; }
	private ApexChartOptions<Record> _lineOptions = new();
	private ApexChartOptions<ScatterPoint> _scatterOptions = new();
	private bool _scatter = false;
	private bool _size = false;
	private Func<ScatterPoint, decimal> _zValueFunc = _ => 5;

	protected override void OnInitialized()
	{
		_lineOptions.Debug = true;
		_lineOptions.Tooltip = new Tooltip
		{
			X = new TooltipX
			{
				Formatter = @"function (val, opts) {return opts.w?.globals.initialSeries[opts.seriesIndex].data[opts.dataPointIndex].extra;}",
				Show = false
			},
			Y = new TooltipY
			{
				Title = new TooltipYTitle {Formatter = @"function(){return ''}"}
			}
		};
		_lineOptions.Yaxis =
		[
			new YAxis
			{
				DecimalsInFloat = 1
			}
		];
		_lineOptions.Xaxis = new XAxis
		{
			AxisBorder = new AxisBorder
			{
				Height = 2
			},
			Labels = new XAxisLabels
			{
				DatetimeUTC = false
			}
		};
		_lineOptions.Chart = new Chart
		{
			Height = "400px",
			Zoom = new Zoom
			{
				Enabled = true,
				Type = AxisType.X,
				AutoScaleYaxis = true
			}
		};
		_lineOptions.Legend = new Legend
		{
			Show = true,
			ShowForSingleSeries = true,
			Position = LegendPosition.Bottom,
			HorizontalAlign = Align.Center
		};
		_scatterOptions.PlotOptions = new PlotOptions()
		{
			Bubble = new PlotOptionsBubble()
			{
				ZScaling = false
			}
		};
		_lineOptions.Stroke = new Stroke()
			{
				Width = 1
			};
		_scatterOptions.Tooltip = new Tooltip()
		{
			Enabled = true,
			Custom = @"function({ series, seriesIndex, dataPointIndex, w }) {
					return `
					<div style=""border: 1px solid #ccc; border-radius: 4px; overflow: hidden; font-family: sans-serif;"">
						<div style=""background: #008FFB; color: white; font-weight: bold; padding: 6px 8px; font-size: 13px;"">
							${w.config.series[seriesIndex].data[dataPointIndex].extra}
						</div>
						<div style=""background: white; color: #333; padding: 6px 8px; font-size: 12px;"">
							X: ${w.config.series[seriesIndex].data[dataPointIndex].x}<br>
							Y: ${w.config.series[seriesIndex].data[dataPointIndex].y}
						</div>
					</div>`;
					}"
		};
		_scatterOptions.Chart = new Chart
		{
			Type = ChartType.Bubble,
			Height = "400px",
			Zoom = new Zoom
			{
				Enabled = true,
				Type = AxisType.Xy,
				AutoScaleYaxis = true
			}
		};
		_scatterOptions.Xaxis = new XAxis()
			{
				DecimalsInFloat = 1
			};
		_scatterOptions.Yaxis =
		[
			new YAxis
			{
				DecimalsInFloat = 1
			}
		];
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await OnRefReady.InvokeAsync(_lineChartRef);
		}
	}

	private List<YAxisInfo> _yAxisInfos =
	[
		new() { Title = "mln zł", Identifier = "mln", SeriesNames = [], Opposite = true},
		new() { Title = "%", Identifier = "%", SeriesNames = [], Opposite = true},
		new() { Title = "Wartość bazowa = 100", Identifier = "100", SeriesNames = [], Opposite = false}
	];

	private async Task Refresh(List<SelectionResult> results)
	{
		var nameList = SeriesList.Select(s => s.Name);
		foreach (var result in results.Where(result => !nameList.Contains(result.Caption)))
		{
			var records = await RecordService.GetRecordsAsync(result);
			var seriesItem = new LineSeries
			{
				Name = result.Caption,
				Points = records.ToList()
			};
			SeriesList.Add(seriesItem);

			foreach (var info in _yAxisInfos.Where(info => result.Caption.Contains(info.Identifier)))
			{
				info.SeriesNames.Add(result.Caption);
			}
		}

		LineSeries? toRemove = null;
		foreach (var name in nameList.Where(name => !results.Select(r => r.Caption).Contains(name)))
			toRemove = SeriesList.Find(s => s.Name == name);

		if (toRemove != null)
		{
			SeriesList.Remove(toRemove);

			foreach (var info in _yAxisInfos.Where(info => info.SeriesNames.Contains(toRemove.Name)))
				info.SeriesNames.Remove(toRemove.Name);
		}

		_lineOptions.Yaxis = new List<YAxis>(3);
		foreach (var info in _yAxisInfos.Where(info => info.SeriesNames.Any()))
			_lineOptions.Yaxis.Add(new YAxis
			{
				DecimalsInFloat = 1, 
				SeriesName = info.SeriesNames, 
				Title = new AxisTitle { Text = info.Title }, 
				ForceNiceScale = false,
				Opposite = info.Opposite,
				TickAmount = 10,
				//StepSize = Math.Ceiling((double)SeriesList.First(series => info.SeriesNames.Contains(series.Name)).Points.Select(p => p.Value).Max() * 0.1)
				//Max = SeriesList.Where(series => info.SeriesNames.Contains(series.Name)).Select(s => s.Margin(r => r.Value).Item2).Max()
			});

		await InvokeAsync(StateHasChanged);
		if (_lineChartRef != null)
		{
			await _lineChartRef.UpdateSeriesAsync();
			await _lineChartRef.UpdateOptionsAsync(true, true, true);
		}

		if (SeriesList.Count != 2)
			await SetupScatter(false);
	}

	public async Task SetupScatter(bool value)
	{
		_scatter = value;
		if (!value)
		{
			if(_scatterRef is not null)
				await SwitchSize(false);
			return;
		}
			

		await Task.Yield();
		
		ScatterSeries = new ScatterSeries(SeriesList.First(), SeriesList.Last());
		var ymargin = ScatterSeries.Margin(x => x.Y);
		_scatterOptions.Yaxis[0].Min = ymargin.Item1;
		_scatterOptions.Yaxis[0].Max = ymargin.Item2;

		var xmargin = ScatterSeries.Margin(x => x.X);
		_scatterOptions.Xaxis.Min = xmargin.Item1;
		_scatterOptions.Xaxis.Max = xmargin.Item2;

		_scatterOptions.Xaxis.Title = new AxisTitle { Text = ScatterSeries.NameX };
		_scatterOptions.Yaxis[0].Title = new AxisTitle { Text = ScatterSeries.NameY };

		if(_scatterRef!=null)
			await _scatterRef.UpdateOptionsAsync(true, true, true);
	}

	public async Task SwitchSize(bool value)
	{
		_size = value;
		if (_scatterRef != null)
			await _scatterRef.UpdateSeriesAsync();
	}

	private class YAxisInfo
	{
		public required string Title;
		public required string Identifier;
		public required SeriesName SeriesNames;
		public bool Opposite;
	}

}
